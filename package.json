{
	"name": "svelte-elevenlabs",
	"version": "0.5.0",
	"description": "A community-driven Svelte 5 library and starter kit for ElevenLabs Conversational AI and low-latency audio streaming.",
	"license": "MIT",
	"author": "AnonymousGCA (https://github.com/GABRYCA)",
	"contributors": [
		{
			"name": "AnonymousGCA",
			"url": "https://github.com/GABRYCA"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/GABRYCA/svelte-elevenlabs.git"
	},
	"homepage": "https://gabryca.github.io/svelte-elevenlabs/",
	"bugs": {
		"url": "https://github.com/GABRYCA/svelte-elevenlabs/issues"
	},
	"type": "module",
	"packageManager": "bun@1.4.3",
	"engines": {
		"node": ">=22.17.0",
		"bun": ">=1.4.0"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"elevenlabs",
		"conversational-ai",
		"voice",
		"audio",
		"websocket",
		"runes",
		"streaming",
		"typescript",
		"pcm",
		"audio-worklet"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && svelte-kit sync && svelte-package && publint",
		"build:app": "vite build",
		"build:bun": "bun --bun vite build --mode bun",
		"build:pages": "vite build --mode pages",
		"start": "node --env-file-if-exists=.env build",
		"start:bun": "bun build/index.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"package": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:live": "vitest run --config vitest.live.config.ts",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./audio": {
			"types": "./dist/audio/audioManager.d.ts",
			"default": "./dist/audio/audioManager.js"
		},
		"./types": {
			"types": "./dist/types/index.d.ts",
			"default": "./dist/types/index.js"
		},
		"./package.json": "./package.json"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/azeret-mono": "^5.3.0",
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@sveltejs/adapter-bun": "^1.0.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/package": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "24.1.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.25",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"esm-env": "^1.2.2"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
