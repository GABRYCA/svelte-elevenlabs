# Server-only secret. Never prefix this with PUBLIC_.
# Used by src/routes/api/signed-url/+server.ts to mint short-lived WebSocket URLs.
ELEVENLABS_API_KEY=

# Optional: prefills the demo console with a public agent id.
# The id itself is safe to expose; the API key is not.
PUBLIC_ELEVENLABS_AGENT_ID=agent_examplePublicId

# Optional: set to "static" only for the GitHub Pages build.
# build:pages forces this automatically. Leave it unset for local and server builds.
# PUBLIC_HOSTING_MODE=static
